# Copy this to a local .env for `wrangler pages dev`, and set the same
# values as Cloudflare Pages environment variables/secrets for production.
# See README.md for where to get each value.

# Razorpay (Settings -> API Keys in the Razorpay dashboard)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Supabase (Project Settings -> API in the Supabase dashboard)
SUPABASE_URL=
# service_role key — server-side only, NEVER expose this in client code
SUPABASE_SERVICE_KEY=
